#!/usr/bin/env bash
#
# omp-orca-role — run the Orca role-session controller (bin/omp-orca-role.ts).
# Symlink-safe: installed copies (e.g. ~/.local/bin/omp-orca-role) resolve back
# to this checkout, so the controller always runs from the repo it belongs to.

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in
    /*) ;;
    *) SOURCE="$DIR/$SOURCE" ;;
  esac
done
CONTROLLER_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"

command -v bun >/dev/null 2>&1 || { echo "omp-orca-role: bun is required on PATH" >&2; exit 1; }
exec bun "$CONTROLLER_DIR/omp-orca-role.ts" "$@"
