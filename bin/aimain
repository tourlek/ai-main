#!/usr/bin/env bash
#
# aimain — attach the ai-main central baseline to any folder.
#
#   aimain link <path> [--knowledge <name>]
#   aimain unlink <path> [--keep-files]
#   aimain list
#   aimain deploy [<path> | --all] [--sync]
#   aimain doctor
#   aimain build | adapters deploy | hooks install | shims
#
# The workspace registry lives in config/workspaces.json ({{HOME}}-portable).
# Each registered folder gets ONE compiled knowledge file (AGENTS.md) plus
# CLAUDE.md / GEMINI.md symlinks to it, so every tool reads repo-specific facts
# from the folder root while global rules keep loading from the tool's own home.

set -euo pipefail

AI_MAIN="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ACTUAL_HOME="${HOME:-/Users/$(whoami)}"
REGISTRY="${AI_MAIN}/config/workspaces.json"
KNOWLEDGE_DIR="${AI_MAIN}/knowledge"
CONTEXT_DIR="${AI_MAIN}/context"

# Stable ownership marker for generated workspace files; match the entire line.
KNOWLEDGE_MARKER="<!-- generated by ai-main install.sh — edit ai-main/knowledge/ instead -->"
ALIAS_NAMES=(CLAUDE.md GEMINI.md)
CURSOR_RULE=".cursor/rules/ai-main-shared.mdc"
CURSOR_MARKER="<!-- generated by ai-main — shared Cursor baseline -->"
# Root-anchored on purpose: a bare "AGENTS.md" in info/exclude also hides a legitimate
# nested packages/*/AGENTS.md, and info/exclude is shared by every worktree of the repo.
EXCLUDE_ENTRIES=(/AGENTS.md /CLAUDE.md /GEMINI.md /.cursor/rules/ai-main-shared.mdc)

RED='\033[0;31m'; GREEN='\033[0;32m'; BLUE='\033[0;34m'; YELLOW='\033[0;33m'; BOLD='\033[1m'; NC='\033[0m'
SYNC_MODE=0

die()  { echo -e "${RED}✗${NC} $*" >&2; exit 1; }
warn() { echo -e "  ${YELLOW}⚠${NC} $*"; }
ok()   { echo -e "  ${GREEN}✓${NC} $*"; }

command -v jq >/dev/null 2>&1 || die "jq is required (brew install jq)"
[ -f "$REGISTRY" ] || die "registry not found: $REGISTRY"

# --- path helpers -----------------------------------------------------------

abs_path() {
    local p="${1/#\~/$ACTUAL_HOME}"
    if [ -d "$p" ]; then (cd "$p" && pwd)
    else (cd "$(dirname "$p")" 2>/dev/null && printf '%s/%s\n' "$(pwd)" "$(basename "$p")")
    fi
}

# {{HOME}}/x <-> /Users/me/x
expand_home() { printf '%s' "${1//\{\{HOME\}\}/$ACTUAL_HOME}"; }
portable_path() {
    case "$1" in
        "$ACTUAL_HOME"/*) printf '{{HOME}}/%s' "${1#"$ACTUAL_HOME"/}" ;;
        *) printf '%s' "$1" ;;
    esac
}

expand_placeholders() { sed -e "s|{{HOME}}|${ACTUAL_HOME}|g" -e "s|{{AI_MAIN}}|${AI_MAIN}|g"; }

# --- registry ---------------------------------------------------------------

registry_paths()   { jq -r '.workspaces[].path' "$REGISTRY"; }
registry_field()   { # <path-as-stored> <field>
    jq -r --arg p "$1" --arg f "$2" '.workspaces[] | select(.path == $p) | .[$f] // empty' "$REGISTRY"
}
registry_stored_key() { # <abs path> -> the stored key that resolves to it, or empty
    local abs="$1" stored
    while IFS= read -r stored; do
        [ "$(expand_home "$stored")" = "$abs" ] && { printf '%s' "$stored"; return 0; }
    done < <(registry_paths)
    return 0
}

# Never pipe jq into the writer: a failed producer yields empty stdin, and `jq empty`
# accepts an empty stream — that would silently truncate the registry to nothing.
registry_apply() { # <jq filter> [--arg pairs...]
    local filter="$1"; shift
    local tmp; tmp="$(mktemp)"
    if ! jq "$@" "$filter" "$REGISTRY" > "$tmp"; then
        rm -f "$tmp"; die "registry update failed — $REGISTRY left untouched"
    fi
    if [ ! -s "$tmp" ] || ! jq -e '.workspaces | type == "array"' "$tmp" >/dev/null 2>&1; then
        rm -f "$tmp"; die "refusing to write a registry without a workspaces array"
    fi
    mv "$tmp" "$REGISTRY"
}

registry_add() { # <stored path> <knowledge> — merges into an existing entry, keeps extra fields
    registry_apply '
        (.workspaces // []) as $ws
        | ($ws | map(select(.path == $p)) | first // {}) as $old
        | .workspaces = (($ws | map(select(.path != $p))) + [$old + {path: $p, knowledge: $k}])
        | .workspaces |= sort_by(.path)
    ' --arg p "$1" --arg k "$2"
}

registry_remove() { # <stored path>
    registry_apply '.workspaces |= map(select(.path != $p))' --arg p "$1"
}

# --- knowledge --------------------------------------------------------------

detect_stack() { # <workspace>
    local ws="$1" parts=()
    if [ -f "$ws/package.json" ]; then parts+=("Node/JS"); fi
    if [ -f "$ws/nuxt.config.js" ] || [ -f "$ws/nuxt.config.ts" ]; then parts+=("Nuxt"); fi
    if [ -f "$ws/pubspec.yaml" ]; then parts+=("Flutter/Dart"); fi
    if [ -f "$ws/go.mod" ]; then parts+=("Go"); fi
    if [ -f "$ws/Cargo.toml" ]; then parts+=("Rust"); fi
    if [ -f "$ws/pyproject.toml" ] || [ -f "$ws/requirements.txt" ]; then parts+=("Python"); fi
    if [ -f "$ws/composer.json" ]; then parts+=("PHP"); fi
    if [ -f "$ws/Gemfile" ]; then parts+=("Ruby"); fi
    if [ ${#parts[@]} -eq 0 ]; then printf 'unknown'; else (IFS=', '; printf '%s' "${parts[*]}"); fi
}

guess_knowledge() { # <workspace> -> knowledge name
    local ws="$1" base remote remote_base
    # Git remote first: a linked worktree's directory name (.claude-worktrees/oho-1272-…)
    # says nothing about which repo it is, but the remote does.
    remote="$(git -C "$ws" remote get-url origin 2>/dev/null || true)"
    if [ -n "$remote" ]; then
        remote_base="$(basename "${remote%.git}")"
        if [ -f "${KNOWLEDGE_DIR}/${remote_base}.md" ]; then printf '%s' "$remote_base"; return 0; fi
    fi
    base="$(basename "$ws")"
    if [ -f "${KNOWLEDGE_DIR}/${base}.md" ]; then printf '%s' "$base"; return 0; fi
    printf '_generic'
}

sed_escape() { printf '%s' "$1" | sed -e 's|[\\&]|\\\0|g'; }

compile_knowledge() { # <knowledge src> <out file> <workspace>
    local src="$1" out="$2" ws="$3" tmp line import_path ws_name ws_stack ws_path
    tmp="$(mktemp)"
    # Resolved once, not per line — this runs for every workspace on every launchd sync.
    ws_name="$(sed_escape "$(basename "$ws")")"
    ws_stack="$(sed_escape "$(detect_stack "$ws")")"
    ws_path="$(sed_escape "$ws")"
    echo "$KNOWLEDGE_MARKER" > "$tmp"
    while IFS= read -r line || [ -n "$line" ]; do
        if [[ "$line" =~ ^@ ]]; then
            import_path="${line#@}"
            import_path="${import_path//\{\{HOME\}\}/$ACTUAL_HOME}"
            import_path="${import_path//\{\{AI_MAIN\}\}/$AI_MAIN}"
            if [ -f "$import_path" ]; then
                cat "$import_path" >> "$tmp"; echo "" >> "$tmp"
            else
                # Half a knowledge file is worse than none: it still carries the marker,
                # so every later check would treat it as a healthy deployment.
                rm -f "$tmp"
                warn "knowledge import not found: ${import_path} — refusing to write a partial ${out}"
                return 1
            fi
        else
            printf '%s\n' "$line" \
                | sed -e "s|{{WORKSPACE_NAME}}|${ws_name}|g" \
                      -e "s|{{WORKSPACE_PATH}}|${ws_path}|g" \
                      -e "s|{{DETECTED_STACK}}|${ws_stack}|g" \
                | expand_placeholders >> "$tmp"
        fi
    done < "$src"
    mv "$tmp" "$out"
}

# --- git guards -------------------------------------------------------------

git_tracks() { # <workspace> <file>
    git -C "$1" ls-files --error-unmatch "$2" >/dev/null 2>&1
}

is_ours() { # <file> — exact generated marker, or an alias to our regular AGENTS.md
    local target="$1"
    if [ -L "$target" ]; then
        case "$(basename "$target")" in CLAUDE.md|GEMINI.md) ;; *) return 1 ;; esac
        [ "$(readlink "$target")" = "AGENTS.md" ] || return 1
        target="$(dirname "$target")/AGENTS.md"
        [ ! -L "$target" ] || return 1
    fi
    if [ "$(basename "$target")" = "ai-main-shared.mdc" ]; then
        [ -f "$target" ] && grep -qxF "$CURSOR_MARKER" "$target"
    else
        [ -f "$target" ] && head -1 "$target" | grep -qxF "$KNOWLEDGE_MARKER"
    fi
}

# Backups go OUTSIDE the work repo — a stray AGENTS.md.backup-* inside it shows up as
# untracked, and the user runs several AI tools in parallel on the same repos.
backup_outside_repo() { # <file>
    local src="$1" dest_dir flat
    dest_dir="${ACTUAL_HOME}/.ai-backup-$(date +%Y%m%d_%H%M%S)"
    mkdir -p "$dest_dir"
    flat="$(printf '%s' "${src#"$ACTUAL_HOME"/}" | tr '/' '_')"
    mv "$src" "${dest_dir}/${flat}"
    warn "backed up hand-written file -> ${dest_dir}/${flat}"
}

add_git_exclude() { # <workspace> — belt-and-braces on top of the global gitignore
    local ws="$1" exclude entry
    # --git-path (not --git-dir): inside a linked worktree the private gitdir is
    # .git/worktrees/<name>, whose info/exclude git never reads — the real one
    # lives in the common dir. The user runs .claude-worktrees/ in several repos.
    exclude="$(git -C "$ws" rev-parse --git-path info/exclude 2>/dev/null)" || return 0
    [ -n "$exclude" ] || return 0
    case "$exclude" in /*) ;; *) exclude="${ws}/${exclude}" ;; esac
    mkdir -p "$(dirname "$exclude")"; touch "$exclude"
    for entry in "${EXCLUDE_ENTRIES[@]}"; do
        is_ours "${ws}${entry}" || continue
        git_tracks "$ws" "${entry#/}" && continue
        grep -qxF "$entry" "$exclude" || echo "$entry" >> "$exclude"
    done
}

# --- deploy -----------------------------------------------------------------

deploy_one() { # <abs workspace> <knowledge name> ; returns 1 when skipped
    local ws="$1" kname="$2" ksrc target alias_path alias_name
    [ -d "$ws" ] || { warn "${ws} — not a directory, skipped"; return 1; }

    ksrc="${KNOWLEDGE_DIR}/${kname}.md"
    [ -f "$ksrc" ] || { warn "${ws} — knowledge/${kname}.md missing, skipped"; return 1; }

    target="${ws}/AGENTS.md"
    if git_tracks "$ws" AGENTS.md; then
        warn "${target} is tracked by that repo's git — skipped"; return 1
    fi
    if { [ -e "$target" ] || [ -L "$target" ]; } && ! is_ours "$target"; then
        warn "${target} is not ai-main-managed — preserved; integrate shared guidance manually"; return 1
    fi
    compile_knowledge "$ksrc" "$target" "$ws" || return 1

    for alias_name in "${ALIAS_NAMES[@]}"; do
        alias_path="${ws}/${alias_name}"
        if git_tracks "$ws" "$alias_name"; then
            warn "${alias_path} is tracked by that repo's git — skipped"; continue
        fi
        if { [ -e "$alias_path" ] || [ -L "$alias_path" ]; } && ! is_ours "$alias_path"; then
            warn "${alias_path} is not ai-main-managed — preserved"; continue
        fi
        ln -sfn "AGENTS.md" "$alias_path"
    done

    # Cursor User Rules have no supported file-deploy API. Use documented project rules.
    local cursor_path="${ws}/${CURSOR_RULE}" baseline="${AI_MAIN}/build/full/SYSTEM.md"
    if [ -L "${ws}/.cursor" ] || [ -L "${ws}/.cursor/rules" ] || git_tracks "$ws" "$CURSOR_RULE"; then
        warn "${cursor_path} has a local owner or symlinked parent — preserved"
    elif { [ -e "$cursor_path" ] || [ -L "$cursor_path" ]; } && ! is_ours "$cursor_path"; then
        warn "${cursor_path} is not ai-main-managed — preserved"
    elif [ ! -f "$baseline" ]; then
        warn "Cursor baseline missing — run aimain build before deployment"
    else
        mkdir -p "$(dirname "$cursor_path")"
        local cursor_tmp; cursor_tmp="$(mktemp)"
        { printf '%s\n' '---' 'description: Shared ai-main safety and workflow' 'alwaysApply: true' '---' '' "$CURSOR_MARKER"; cat "$baseline"; } > "$cursor_tmp"
        mv "$cursor_tmp" "$cursor_path"
    fi
    add_git_exclude "$ws"
    ok "${ws}/AGENTS.md <- knowledge/${kname}.md (local alias owners preserved)"
    return 0
}

deploy_all() {
    local stored abs kname failed=0
    echo -e "${BLUE}📚 Deploying knowledge to registered workspaces...${NC}"
    while IFS= read -r stored; do
        abs="$(expand_home "$stored")"
        # A path that does not exist on this machine is expected (the registry is shared
        # across machines) and is not a failure; anything else is.
        [ -d "$abs" ] || continue
        kname="$(registry_field "$stored" knowledge)"
        [ -n "$kname" ] || kname="$(guess_knowledge "$abs")"
        deploy_one "$abs" "$kname" || failed=$((failed + 1))
    done < <(registry_paths)
    if [ "$failed" -gt 0 ]; then
        warn "${failed} workspace(s) did not deploy — run './bin/aimain doctor'"
        return 1
    fi
    return 0
}

# --- prompt profiles --------------------------------------------------------

BUILD_DIR="${AI_MAIN}/build"
PROFILE_SOURCES=(
    "config/profile.md"
    "config/style.md"
    "config/workflow.md"
    "memory/SHARED.md"
    "memory/lessons/RULES.md"
)
# One ceiling, a warning rather than a failure: a deploy path that launchd runs every 6h
# must never brick over a prompt growing 5%. There is a single shared profile (full).
declare -a TIER_NAMES=(full)
tier_budget() { echo 4000; }

# bytes/4 is the estimator verify.sh has always used, but it overcounts Thai badly: every
# Thai character is 3 UTF-8 bytes, and these rules are half Thai. Split the two scripts —
# ~4 chars/token for ASCII, ~1.5 chars/token for non-ASCII.
est_tokens() { # <file>
    local bytes chars nonascii ascii
    bytes=$(wc -c < "$1" | tr -d ' ')
    chars=$(wc -m < "$1" | tr -d ' ')
    nonascii=$(( (bytes - chars) / 2 ))
    ascii=$(( chars - nonascii ))
    [ "$ascii" -lt 0 ] && ascii=0
    echo $(( ascii / 4 + (nonascii * 2) / 3 ))
}

cmd_build() {
    local tier src out tokens budget rel
    case "${1:-}" in
        "") ;;
        --legacy) [ "$#" -eq 1 ] || die "usage: aimain build [--legacy]" ;;  # accepted no-op: kept for older callers
        *) die "usage: aimain build [--legacy]" ;;
    esac
    mkdir -p "$BUILD_DIR"
    for tier in "${TIER_NAMES[@]}"; do
        rm -rf "${BUILD_DIR:?}/${tier}"; mkdir -p "${BUILD_DIR}/${tier}"
        : > "${BUILD_DIR}/${tier}/SYSTEM.md"
        for rel in "${PROFILE_SOURCES[@]}"; do
            src="${AI_MAIN}/${rel}"
            [ -f "$src" ] || { warn "profile source missing: $rel"; continue; }
            out="${BUILD_DIR}/${tier}/$(basename "$rel")"
            cp "$src" "$out"
            cat "$out" >> "${BUILD_DIR}/${tier}/SYSTEM.md"
            echo "" >> "${BUILD_DIR}/${tier}/SYSTEM.md"
        done
        tokens="$(est_tokens "${BUILD_DIR}/${tier}/SYSTEM.md")"
        budget="$(tier_budget "$tier")"
        if [ "$tokens" -gt "$budget" ]; then
            warn "profile ${tier}: ~${tokens} tokens over the ${budget} ceiling"
        else
            ok "profile ${tier}: ~${tokens} tokens (ceiling ${budget})"
        fi
    done
    # Content hashes identify dirty-source builds without pretending HEAD is the deployed content.
    python3 - "$AI_MAIN" "${PROFILE_SOURCES[@]}" <<'PY'
import hashlib, json, pathlib, sys
root = pathlib.Path(sys.argv[1])
def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()
manifest = {
    "schemaVersion": 1,
    "sources": {name: digest(root / name) for name in sys.argv[2:]},
    "profiles": {tier: digest(root / "build" / tier / "SYSTEM.md")
                 for tier in ("full",)},
}
(root / "build/profile-manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
PY
}

cmd_budget() { # machine-readable, used by scripts/verify.sh
    local tier
    for tier in "${TIER_NAMES[@]}"; do
        if [ ! -f "${BUILD_DIR}/${tier}/SYSTEM.md" ]; then
            echo "${tier} - $(tier_budget "$tier")"; continue
        fi
        echo "${tier} $(est_tokens "${BUILD_DIR}/${tier}/SYSTEM.md") $(tier_budget "$tier")"
    done
}

# --- adapters (any tool beyond the five original targets) -------------------

ADAPTERS_DIR="${AI_MAIN}/adapters"
ADAPTER_MARKER="<!-- generated by ai-main — edit ai-main/config/ + memory/ instead -->"

adapter_detect_ok() { # <detect string>
    local spec="$1" kind value
    kind="${spec%%:*}"; value="$(expand_home "${spec#*:}")"
    case "$kind" in
        dir)  [ -d "$value" ] ;;
        file) [ -f "$value" ] ;;
        bin)  command -v "$value" >/dev/null 2>&1 ;;
        *)    return 1 ;;
    esac
}

cmd_adapters() {
    local action="${1:-deploy}" manifest id profile entry skills detect src skill_dir name target
    [ -d "$ADAPTERS_DIR" ] || return 0
    for manifest in "$ADAPTERS_DIR"/*.json; do
        [ -f "$manifest" ] || continue
        id="$(jq -r '.id' "$manifest")"
        detect="$(jq -r '.detect // empty' "$manifest")"
        profile="$(jq -r '.profile // "full"' "$manifest")"
        entry="$(expand_home "$(jq -r '.entry // empty' "$manifest")")"
        skills="$(expand_home "$(jq -r '.skills // empty' "$manifest")")"

        if [ -n "$detect" ] && ! adapter_detect_ok "$detect"; then
            [ "$action" = "list" ] && printf '%-12s %-6s %s\n' "$id" "$profile" "not installed here"
            continue
        fi
        if [ "$action" = "list" ]; then
            printf '%-12s %-6s %s\n' "$id" "$profile" "$entry"
            continue
        fi

        src="${BUILD_DIR}/${profile}/SYSTEM.md"
        if [ ! -f "$src" ]; then warn "${id}: build/${profile}/SYSTEM.md missing — run 'aimain build'"; continue; fi

        if [ -n "$entry" ]; then
            if [ -L "$entry" ] || { [ -e "$entry" ] && ! head -1 "$entry" 2>/dev/null | grep -qxF "$ADAPTER_MARKER"; }; then
                warn "${id}: ${entry} is not a regular ai-main-managed entry — preserved"
            else
                mkdir -p "$(dirname "$entry")"
                { echo "$ADAPTER_MARKER"; cat "$src"; } > "$entry"
                ok "${id}: ${entry} <- profile ${profile}"
            fi
        fi

        if [ -n "$skills" ]; then
            mkdir -p "$skills"
            for skill_dir in "${AI_MAIN}"/skills/*/; do
                [ -f "${skill_dir}SKILL.md" ] || continue
                name="$(basename "${skill_dir%/}")"
                target="${skills}/${name}"
                if [ -e "$target" ] && [ ! -L "$target" ]; then continue; fi
                ln -sfn "${skill_dir%/}" "$target"
            done
            ok "${id}: skills linked into ${skills}"
        fi
    done
}

# --- enforcement (git hooks + PATH shims) -----------------------------------

CHECKS_DIR="${AI_MAIN}/core/checks"
SHIM_BIN="${ACTUAL_HOME}/.ai-main-bin"
declare -a HOOK_PAIRS=("commit-msg:commit-msg-lint.sh" "pre-push:pre-push-guard.sh" "pre-commit:pre-commit-guard.sh")

install_hooks_in() { # <repo>
    local repo="$1" hooks_dir pair hook_name script target
    hooks_dir="$(git -C "$repo" rev-parse --git-path hooks 2>/dev/null)" || return 1
    case "$hooks_dir" in /*) ;; *) hooks_dir="${repo}/${hooks_dir}" ;; esac
    mkdir -p "$hooks_dir"
    for pair in "${HOOK_PAIRS[@]}"; do
        hook_name="${pair%%:*}"; script="${CHECKS_DIR}/${pair##*:}"
        target="${hooks_dir}/${hook_name}"
        [ -f "$script" ] || continue
        if [ -e "$target" ] && [ ! -L "$target" ]; then
            # husky and friends own this slot — chain instead of clobbering
            if grep -q 'ai-main' "$target" 2>/dev/null; then continue; fi
            printf '\n# ai-main check\n"%s" "$@" || exit $?\n' "$script" >> "$target"
            warn "${target} already existed — appended the ai-main check instead of replacing it"
            continue
        fi
        ln -sfn "$script" "$target"
    done
    ok "hooks installed in ${repo}"
}

cmd_hooks() {
    local action="${1:-install}" stored abs
    case "$action" in
        install)
            shift || true
            chmod +x "${CHECKS_DIR}"/*.sh "${CHECKS_DIR}"/shims/* "${AI_MAIN}"/core/hooks/*.sh 2>/dev/null || true
            if [ $# -gt 0 ]; then
                for abs in "$@"; do install_hooks_in "$(abs_path "$abs")" || warn "not a git repo: $abs"; done
            else
                while IFS= read -r stored; do
                    abs="$(expand_home "$stored")"
                    [ -d "$abs" ] || continue
                    git -C "$abs" rev-parse --git-dir >/dev/null 2>&1 || continue
                    install_hooks_in "$abs" || true
                done < <(registry_paths)
            fi
            ;;
        uninstall)
            shift || true
            local hooks_dir pair target
            while IFS= read -r stored; do
                abs="$(expand_home "$stored")"
                [ -d "$abs" ] || continue
                hooks_dir="$(git -C "$abs" rev-parse --git-path hooks 2>/dev/null)" || continue
                case "$hooks_dir" in /*) ;; *) hooks_dir="${abs}/${hooks_dir}" ;; esac
                for pair in "${HOOK_PAIRS[@]}"; do
                    target="${hooks_dir}/${pair%%:*}"
                    if [ -L "$target" ] && [[ "$(readlink "$target")" == "${CHECKS_DIR}"/* ]]; then
                        rm -f "$target"; ok "removed ${target}"
                    fi
                done
            done < <(registry_paths)
            ;;
        *) die "usage: aimain hooks [install|uninstall] [repo...]" ;;
    esac
}

cmd_shims() {
    mkdir -p "$SHIM_BIN"
    local shim name
    for shim in "${CHECKS_DIR}"/shims/*; do
        [ -f "$shim" ] || continue
        name="$(basename "$shim")"
        chmod +x "$shim"
        ln -sfn "$shim" "${SHIM_BIN}/${name}"
        ok "shim ${name} → ${SHIM_BIN}/${name}"
    done
    if ! printf '%s' "${PATH}" | tr ':' '\n' | grep -qx "$SHIM_BIN"; then
        warn "add this to ~/.zshrc so the shims take effect:"
        echo "      export PATH=\"${SHIM_BIN}:\$PATH\""
    fi
}

# --- worktree context -------------------------------------------------------

cmd_context() { # link <workspace> [--knowledge <name>]
    local action="${1:-}" path="" kname="" abs stored target source
    [ "$action" = link ] || die "usage: aimain context link <worktree> [--knowledge <name>]"
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            --knowledge) [ $# -ge 2 ] || die "--knowledge needs a name"; kname="$2"; shift 2 ;;
            -*) die "unknown flag: $1" ;;
            *) [ -z "$path" ] || die "only one worktree path is allowed"; path="$1"; shift ;;
        esac
    done
    [ -n "$path" ] || die "usage: aimain context link <worktree> [--knowledge <name>]"
    abs="$(abs_path "$path")"
    [ -d "$abs" ] || die "not a directory: $abs"
    [ "$abs" = "$AI_MAIN" ] && die "refusing to link ai-main into itself"
    git -C "$abs" rev-parse --show-toplevel >/dev/null 2>&1 || die "not a git worktree: $abs"
    [ -z "$(git -C "$abs" rev-parse --show-prefix)" ] || die "use the git worktree root: $abs"
    stored="$(registry_stored_key "$abs")"
    [ -n "$kname" ] || kname="$([ -n "$stored" ] && registry_field "$stored" knowledge || true)"
    [ -n "$kname" ] || kname="$(guess_knowledge "$abs")"
    [ "$kname" != _generic ] || die "no repo identity found; pass --knowledge <repo> (a knowledge/<repo>.md must exist)"
    [[ "$kname" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] && [ "$kname" != .. ] ||
        die "invalid knowledge name: $kname"
    [ -f "${KNOWLEDGE_DIR}/${kname}.md" ] || die "no knowledge file: knowledge/${kname}.md"

    target="${abs}/.ai"
    source="${CONTEXT_DIR}/${kname}"
    if [ -L "$target" ]; then
        [ "$(readlink "$target")" = "$source" ] || die "${target} is another owner's symlink — preserved"
    elif [ -e "$target" ]; then
        die "${target} already exists — preserved"
    fi
    # The root link is ignored locally; repo-owned .ai paths remain visible to git.
    if git_tracks "$abs" .ai || [ -n "$(git -C "$abs" ls-files -- .ai/)" ]; then
        die "${target} is tracked by the repo — preserved"
    fi
    mkdir -p "${source}/handoffs" "${source}/decisions"
    if [ ! -e "${source}/README.md" ]; then
        printf '# %s shared context\n\nRepo code and docs remain canonical. Keep durable cross-worktree decisions in decisions/ and per-change handoff notes in handoffs/. Record a task-specific smoke result before QA handoff; an unverified run is blocked, not ready. Keep secrets, personal data, and worktree-local scratch out of this shared directory.\n' "$kname" > "${source}/README.md"
    fi
    [ -L "$target" ] || ln -s "$source" "$target"
    local exclude
    exclude="$(git -C "$abs" rev-parse --git-path info/exclude)"
    case "$exclude" in /*) ;; *) exclude="${abs}/${exclude}" ;; esac
    mkdir -p "$(dirname "$exclude")"
    touch "$exclude"
    grep -qxF '/.ai' "$exclude" || printf '%s\n' '/.ai' >> "$exclude"
    ok "${target} -> ${source}"
}

# --- commands ---------------------------------------------------------------

cmd_link() {
    local path="" kname=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --knowledge) [ $# -ge 2 ] || die "--knowledge needs a name"; kname="$2"; shift 2 ;;
            -*)          die "unknown flag: $1" ;;
            *)           path="$1"; shift ;;
        esac
    done
    [ -n "$path" ] || die "usage: aimain link <path> [--knowledge <name>]"

    local abs; abs="$(abs_path "$path")"
    [ -d "$abs" ] || die "not a directory: $abs"
    [ "$abs" = "$AI_MAIN" ] && die "refusing to link ai-main into itself"

    [ -n "$kname" ] || kname="$(guess_knowledge "$abs")"
    [ -f "${KNOWLEDGE_DIR}/${kname}.md" ] || die "no knowledge file: knowledge/${kname}.md"

    if git_tracks "$abs" AGENTS.md; then
        die "${abs}/AGENTS.md is tracked by that repo's git — link refused (that file belongs to the team)"
    fi

    # Deploy first, register only on success — a failed link must not leave a registry entry
    # that the next launchd sync would try to redeploy.
    echo -e "${BLUE}🔗 Linking${NC} ${BOLD}${abs}${NC} ${BLUE}→ knowledge/${kname}.md${NC}"
    deploy_one "$abs" "$kname" || die "deploy failed — nothing registered"
    local stored; stored="$(portable_path "$abs")"
    registry_add "$stored" "$kname"
    if [ "$kname" = "_generic" ]; then
        echo -e "  ${YELLOW}note${NC} using the generic profile — create knowledge/$(basename "$abs").md for real repo knowledge, then re-run link"
    fi
    return 0
}

cmd_unlink() {
    local path="" keep=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --keep-files) keep=1; shift ;;
            -*)           die "unknown flag: $1" ;;
            *)            path="$1"; shift ;;
        esac
    done
    [ -n "$path" ] || die "usage: aimain unlink <path> [--keep-files]"

    local abs stored; abs="$(abs_path "$path")"
    stored="$(registry_stored_key "$abs")"
    [ -n "$stored" ] || die "not in the registry: $abs"

    local f
    if [ "$keep" -eq 0 ] && [ -d "$abs" ]; then
        for f in AGENTS.md "${ALIAS_NAMES[@]}" "$CURSOR_RULE"; do
            if git_tracks "$abs" "$f"; then
                warn "${abs}/${f} is tracked — keeping the instruction set to preserve alias targets"
                keep=1
                break
            fi
        done
    fi
    if [ "$keep" -eq 0 ] && [ -d "$abs" ]; then
        # Check aliases while their generated target still exists.
        for f in "${ALIAS_NAMES[@]}" AGENTS.md "$CURSOR_RULE"; do
            if git_tracks "$abs" "$f"; then warn "${abs}/${f} is tracked — preserved"
            elif is_ours "${abs}/${f}"; then rm -f "${abs}/${f}"; ok "removed ${abs}/${f}"
            elif [ -e "${abs}/${f}" ]; then warn "${abs}/${f} is not ai-main-managed — left in place"
            fi
        done
    fi
    registry_remove "$stored"
    ok "unregistered ${abs}"
}

cmd_list() { # prints the table; returns 1 if any workspace is in a broken state
    local stored abs kname status broken=0
    printf '%-46s %-24s %s\n' "WORKSPACE" "KNOWLEDGE" "STATUS"
    while IFS= read -r stored; do
        abs="$(expand_home "$stored")"
        kname="$(registry_field "$stored" knowledge)"
        [ -n "$kname" ] || kname="?"
        local alias_name missing_alias=""
        if [ ! -d "$abs" ]; then status="missing"
        elif git_tracks "$abs" AGENTS.md; then status="skipped:tracked"
        elif [ ! -f "${KNOWLEDGE_DIR}/${kname}.md" ]; then status="no-knowledge-file"
        elif ! is_ours "${abs}/AGENTS.md"; then status="drifted"
        else
            status="ok"
            for alias_name in "${ALIAS_NAMES[@]}"; do
                if git_tracks "$abs" "$alias_name"; then
                    status="ok (repo owns ${alias_name})"
                elif { [ -e "${abs}/${alias_name}" ] || [ -L "${abs}/${alias_name}" ]; } && ! is_ours "${abs}/${alias_name}"; then
                    status="ok (local owner: ${alias_name})"
                elif ! is_ours "${abs}/${alias_name}"; then
                    missing_alias="$alias_name"
                fi
            done
            if [ -n "$missing_alias" ]; then status="partial: no ${missing_alias} link"; fi
        fi
        case "$status" in
            drifted|no-knowledge-file|partial*) broken=$((broken + 1)) ;;
        esac
        printf '%-46s %-24s %s\n' "${stored/#\{\{HOME\}\}/~}" "$kname" "$status"
    done < <(registry_paths)
    [ "$broken" -eq 0 ]
}

cmd_doctor() {
    local stored abs leaked=0 dirty f file_dirty
    echo -e "${BLUE}🔍 Checking for generated files leaking into workspace git...${NC}"
    while IFS= read -r stored; do
        abs="$(expand_home "$stored")"
        [ -d "$abs" ] || continue
        git -C "$abs" rev-parse --git-dir >/dev/null 2>&1 || continue
        dirty=""
        for f in AGENTS.md "${ALIAS_NAMES[@]}" "$CURSOR_RULE"; do
            is_ours "${abs}/${f}" || continue
            git_tracks "$abs" "$f" && continue
            file_dirty="$(git -C "$abs" status --porcelain -- "$f" 2>/dev/null || true)"
            [ -z "$file_dirty" ] || dirty="${dirty}${file_dirty}"$'\n'
        done
        if [ -n "$dirty" ]; then
            echo -e "  ${RED}✗${NC} ${abs} — generated files visible to git:"; echo "$dirty" | sed 's/^/      /'
            leaked=1
        fi
    done < <(registry_paths)
    if [ "$leaked" -eq 0 ]; then ok "no generated file is visible to any workspace's git"; fi
    echo -e "\n${BLUE}🔍 Workspace status${NC}"
    local broken=0
    cmd_list || broken=1
    if [ "$((leaked + broken))" -gt 0 ]; then
        echo -e "\n${RED}✗ doctor found problems${NC}"; return 1
    fi
    echo -e "\n${GREEN}✓ all registered workspaces healthy${NC}"
    return 0
}

cmd_deploy() {
    local path=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --sync) SYNC_MODE=1; shift ;;
            --all)  shift ;;
            -*)     die "unknown flag: $1" ;;
            *)      path="$1"; shift ;;
        esac
    done
    if [ -n "$path" ]; then
        local abs stored kname; abs="$(abs_path "$path")"
        stored="$(registry_stored_key "$abs")"
        kname="$([ -n "$stored" ] && registry_field "$stored" knowledge || true)"
        [ -n "$kname" ] || kname="$(guess_knowledge "$abs")"
        deploy_one "$abs" "$kname"
    else
        deploy_all
    fi
}

usage() {
    cat <<'EOF'
aimain — attach the ai-main central baseline to any folder.

  aimain link <path> [--knowledge <name>]   register a folder and deploy its knowledge file
  aimain unlink <path> [--keep-files]       remove our files and unregister it
  aimain list                               show every registered workspace and its status
  aimain deploy [<path> | --all] [--sync]   (re)deploy; --all is what install.sh calls
  aimain context link <worktree> [--knowledge <name>]   link shared repo .ai/ into a git worktree
  aimain doctor                             check that generated files stay invisible to git

Registry: config/workspaces.json ({{HOME}}-portable, safe to commit).
Each folder gets one compiled AGENTS.md plus CLAUDE.md / GEMINI.md symlinks to it.
Knowledge is picked from --knowledge, else the git remote name, else the folder name,
else knowledge/_generic.md.
EOF
}

case "${1:-}" in
    build)    shift; cmd_build "$@" ;;
    adapters) shift; cmd_adapters "$@" ;;
    hooks)   shift; cmd_hooks "$@" ;;
    shims)   shift; cmd_shims "$@" ;;
    budget)  shift; cmd_budget "$@" ;;
    context) shift; cmd_context "$@" ;;
    link)    shift; cmd_link "$@" ;;
    unlink)  shift; cmd_unlink "$@" ;;
    list)    shift; cmd_list "$@" ;;
    deploy)  shift; cmd_deploy "$@" ;;
    doctor)  shift; cmd_doctor "$@" ;;
    ""|-h|--help|help) usage ;;
    *)       die "unknown command: $1 (try: aimain --help)" ;;
esac
