#!/usr/bin/env python3
"""oracle-recap: build a small, model-agnostic ORACLE.md recap from plain files (stdlib only, no LLM).

Reads (read-only): ~/ai-main/memory/lessons/RULES.md (hot rules), vault AI Memory/ (curated notes),
AI Inbox/ (candidates: count + titles only, not truth), Hermes USER.md (profile fallback when
AI Memory/Profile.md is missing). Writes only --out (default: dry-run path under backups).

Sections: 1 who the user is · 2 hot rules · 3 ranked memory index · 4 pending review.
Budget: hard cap (default 4000 chars); whole items are dropped from the bottom of sections 4,
then 3, then 1 (rules are never dropped), with a footer saying what was left out.
Ranking (index): importance(type/status) + heat(inbound wikilinks) + recency(frontmatter date
only; missing date = 0, never guessed) + confidence(status). Notes with `superseded_by` are skipped
but counted. Deterministic: no wall-clock in output.

Usage: oracle-recap [--dry-run] [--out PATH] [--budget N] [--install] [--lint]
  --install  write the stable copy ~/.hermes/state/ORACLE.md (read by build-soul.py and imported by
             ~/.claude/CLAUDE.md) and the generated Cursor rule ~/.cursor/rules/oracle.mdc; a changed
             previous copy is moved to ~/.hermes/backups/oracle-history/ first. Unchanged = no write.
"""
import datetime as dt, os, re, sys
from pathlib import Path

HOME = Path.home()
VAULT = HOME / "Tualek"
MEM = VAULT / "AI Memory"
INBOX = VAULT / "AI Inbox"
RULES = HOME / "ai-main" / "memory" / "lessons" / "RULES.md"
USER_MD = HOME / ".hermes" / "memories" / "USER.md"
SOUL = HOME / ".hermes" / "SOUL.md"
DRY_OUT = HOME / ".hermes" / "backups" / "20261025-memory" / "oracle-dryrun" / "ORACLE.md"
BUDGET = 4000  # our choice (oracle-recap design), not a tool limit; override with --budget
STATE_OUT = HOME / ".hermes" / "state" / "ORACLE.md"
CURSOR_OUT = HOME / ".cursor" / "rules" / "oracle.mdc"
HISTORY = HOME / ".hermes" / "backups" / "oracle-history"
CURSOR_HEAD = ("---\ndescription: ORACLE shared memory recap (GENERATED by ~/ai-main/bin/oracle-recap --install; "
               "do not edit, edit the vault/RULES.md and re-run)\nalwaysApply: true\n---\n\n")
WIKI = re.compile(r"\[\[([^\]|#]+)(?:#[^\]|]*)?(?:\|[^\]]*)?\]\]")

TYPE_W = {"memory": 3, "runbook": 2.5, "index": 2, "session-digest": 0.5}
STATUS_W = {"curated": 3, "active": 3, "candidate": 1, "historical": 1, "promoted": 2,
            "superseded": 0, "dropped": 0}


def tilde(p):
    return str(p).replace(str(HOME), "~")


def read(p):
    return Path(p).read_text(encoding="utf-8", errors="replace")


def frontmatter(text):
    m = re.match(r"^---\n(.*?)\n---\n?(.*)$", text, re.S)
    if not m:
        return {}, text
    fm = {}
    for line in m.group(1).splitlines():
        mm = re.match(r"^([\w-]+):\s*(.*)$", line)
        if mm:
            fm[mm.group(1)] = mm.group(2).strip().strip('"\'')
    return fm, m.group(2)


def gist(fm, body, n=80):
    if fm.get("description"):
        g = fm["description"]
    else:
        g = ""
        for line in body.splitlines():
            s = line.strip()
            if not s or s.startswith(("#", "|", "---", ">", "```", "![")):
                continue
            g = re.sub(r"^[-*\d.]+\s+", "", s)
            break
    g = WIKI.sub(lambda m: m.group(1).split("/")[-1], g)
    g = re.sub(r"[*_`]", "", g)
    return g if len(g) <= n else g[: n - 1].rstrip() + "…"


def parse_date(s):
    m = re.match(r"(\d{4}-\d{2}-\d{2})", s or "")
    return dt.date.fromisoformat(m.group(1)) if m else None


def vault_files():
    return sorted(p for p in VAULT.rglob("*.md") if not any(x.startswith(".") for x in p.relative_to(VAULT).parts))


def resolve(link, by_rel, by_name):
    link = link.strip()
    if link in by_rel:
        return by_rel[link]
    base = link.split("/")[-1]
    c = by_name.get(base, [])
    return c[0] if len(c) == 1 else (sorted(c)[0] if c else None)


def load_vault():
    files = vault_files()
    by_rel = {str(p.relative_to(VAULT))[:-3]: p for p in files}
    by_name = {}
    for p in files:
        by_name.setdefault(p.stem, []).append(p)
    inbound, links = {}, {}
    for p in files:
        t = read(p)
        links[p] = WIKI.findall(t)
        for l in set(links[p]):
            r = resolve(l, by_rel, by_name)
            if r and r != p:
                inbound[r] = inbound.get(r, 0) + 1
    return files, by_rel, by_name, inbound, links


def rank_notes(inbound):
    notes, superseded = [], []
    dates = []
    for p in sorted(MEM.rglob("*.md")):
        if p.name == "Home.md" and p.parent == MEM:
            continue
        fm, body = frontmatter(read(p))
        if fm.get("superseded_by") or fm.get("superseded-by"):
            superseded.append(p)
            continue
        d = parse_date(fm.get("last-reviewed")) or parse_date(fm.get("created")) or parse_date(fm.get("date"))
        if d:
            dates.append(d)
        notes.append({"path": p, "fm": fm, "body": body, "date": d})
    newest = max(dates) if dates else None
    for n in notes:
        fm = n["fm"]
        imp = TYPE_W.get(fm.get("type", ""), 1)
        conf = STATUS_W.get(fm.get("status", ""), 1.5)
        heat = min(inbound.get(n["path"], 0), 5) * 0.6
        rec = 0.0
        if n["date"] and newest:
            rec = max(0.0, 2.0 - (newest - n["date"]).days / 15.0)
        n["score"] = round(imp + conf + heat + rec, 3)
    notes.sort(key=lambda n: (-n["score"], str(n["path"])))
    return notes, superseded


def profile_items():
    prof = MEM / "Profile.md"
    if prof.exists():
        fm, body = frontmatter(read(prof))
        items = [re.sub(r"^[-*]\s+", "", l.strip()) for l in body.splitlines() if l.strip().startswith(("-", "*"))]
        return items, tilde(prof)
    if USER_MD.exists():
        items = [e.strip() for e in read(USER_MD).split("\n§\n") if e.strip()]
        return items, tilde(USER_MD) + " (fallback: AI Memory/Profile.md not found)"
    return [], "none"


def rule_items():
    out = []
    for l in read(RULES).splitlines():
        if l.startswith("- [*]"):
            r = l[5:].strip()
            hits = re.search(r"hits:\s*(\d+)", r)
            r = re.sub(r"\s*\(src:[^()]*(?:\([^()]*\)[^()]*)*\)\s*$", "", r)
            out.append(r + (f" (hits:{hits.group(1)})" if hits else ""))
    return out


def inbox_items():
    """Titles of Inbox candidates; bulk exports are grouped so the list stays short."""
    groups, single = {}, []
    for p in sorted(INBOX.glob("*.md")):
        if p.name == "Home.md":
            continue
        t = re.sub(r"^\d{4}-\d{2}-\d{2} - ", "", p.stem)
        m = re.match(r"^(Hermes USER|Claude auto-memory) (?:- )?(.*)$", t)
        if m:
            groups.setdefault(m.group(1), []).append(m.group(2))
        else:
            single.append(t)
    out = [f"{k} ×{len(v)}" + (f": {', '.join(v)}" if k.startswith("Claude") else "") for k, v in sorted(groups.items())]
    return single + out, sum(len(v) for v in groups.values()) + len(single)


def short(s, n):
    s = re.sub(r"\s+", " ", s).strip()
    return s if len(s) <= n else s[: n - 1].rstrip() + "…"


def build(budget):
    files, by_rel, by_name, inbound, _ = load_vault()
    notes, superseded = rank_notes(inbound)
    prof, prof_src = profile_items()
    rules = rule_items()
    inbox, n_inbox = inbox_items()
    src_mtime = max(p.stat().st_mtime for p in [RULES, USER_MD, *files] if p.exists())
    stamp = dt.datetime.fromtimestamp(src_mtime).astimezone().strftime("%Y-%m-%d %H:%M %z")

    head = ("# ORACLE — shared memory recap\n"
            f"Generated by ai-main/bin/oracle-recap from plain files; newest source mtime {stamp}. "
            "Truth lives in the vault (`~/Tualek/AI Memory/`) and `RULES.md`; read the linked note before acting on an item. "
            "Capture new lessons with skill `self-learning` (create-only in `~/Tualek/AI Inbox/`).\n")
    sec = {
        "who": ("\n## 1. Who you work for\n", [f"- {short(x, 170)}" for x in prof], f"see {prof_src}"),
        "rules": ("\n## 2. Hot rules (always apply)\n", [f"- {short(r, 330)}" for r in rules], f"full text + sources: {tilde(RULES)}"),
        "index": ("\n## 3. Memory index (ranked)\n",
                  [f"- [{str(n['path'].relative_to(MEM))[:-3]}]({tilde(n['path'])}) — {gist(n['fm'], n['body'])}" for n in notes],
                  f"see {tilde(MEM / 'Home.md')}"),
        "inbox": (f"\n## 4. Pending review ({n_inbox} candidates in AI Inbox, not yet truth)\n",
                  [f"- {short(t, 70)}" for t in inbox], f"see {tilde(INBOX)}/"),
    }
    keep = {k: len(v[1]) for k, v in sec.items()}
    keep["who"] = min(keep["who"], 4)
    sup_note = ""
    if superseded:
        names = ", ".join(str(p.relative_to(MEM))[:-3] for p in superseded)
        sup_note = f"\nSuperseded (not used, kept for history): {len(superseded)} — {names}.\n"

    def render():
        out = head
        for k in ("who", "rules", "index", "inbox"):
            title, items, more = sec[k]
            out += title + "".join(i + "\n" for i in items[: keep[k]])
            left = len(items) - keep[k]
            if left:
                out += f"- …{left} more: {more}\n"
        return out + sup_note

    # trim whole items from the bottom: inbox → index(min 5) → who(min 3) → index → who; rules never trimmed
    order = [("inbox", 0), ("index", 5), ("who", 3), ("index", 0), ("who", 1)]
    for k, floor in order:
        while len(render()) > budget and keep[k] > floor:
            keep[k] -= 1
    text = render()
    trimmed = {k: len(sec[k][1]) - keep[k] for k in sec}
    return text, trimmed, superseded, len(text) <= budget


def lint():
    issues = []
    files, by_rel, by_name, inbound, links = load_vault()
    # index entries → missing files
    for p in files:
        fm, _ = frontmatter(read(p))
        if fm.get("type") == "index" or p.name == "Home.md":
            for l in sorted(set(links[p])):
                if not resolve(l, by_rel, by_name):
                    issues.append(f"BROKEN-LINK {tilde(p)} → [[{l}]]")
    # superseded_by targets must resolve
    for p in sorted(MEM.rglob("*.md")):
        fm, _ = frontmatter(read(p))
        for l in WIKI.findall(fm.get("superseded_by", "")):
            if not resolve(l, by_rel, by_name):
                issues.append(f"BROKEN-SUPERSEDED_BY {tilde(p)} → [[{l}]]")
    # AI Memory notes unreachable from any index
    idx = {p for p in files if frontmatter(read(p))[0].get("type") == "index" or p.name == "Home.md"}
    reach = set()
    for p in idx:
        for l in links[p]:
            r = resolve(l, by_rel, by_name)
            if r:
                reach.add(r)
    for p in sorted(MEM.rglob("*.md")):
        if p not in reach and not (p.name == "Home.md" and p.parent == MEM):
            issues.append(f"UNINDEXED {tilde(p)}")
    # frontmatter
    for p in sorted(MEM.rglob("*.md")):
        fm, _ = frontmatter(read(p))
        miss = [k for k in ("type", "scope") if k not in fm]
        if fm.get("type") == "memory":
            miss += [k for k in ("status",) if k not in fm]
            if not any(k in fm for k in ("created", "last-reviewed", "date")):
                miss.append("created|last-reviewed")
        if miss:
            issues.append(f"FRONTMATTER {tilde(p)} missing {','.join(miss)}")
    old_tpl = 0
    for p in sorted(INBOX.glob("*.md")):
        if p.name == "Home.md":
            continue
        fm, _ = frontmatter(read(p))
        miss = [k for k in ("type", "status", "created") if k not in fm]
        if miss:
            issues.append(f"FRONTMATTER {tilde(p)} missing {','.join(miss)}")
        elif not all(k in fm for k in ("agent", "model", "source")):
            old_tpl += 1
    if old_tpl:
        issues.append(f"INFO {old_tpl} Inbox candidates predate the agent/model/source template fields")
    # sizes
    rb = len(RULES.read_bytes())
    issues.append(f"{'WARN' if rb > 2048 else 'OK'} RULES.md {rb} B vs 2048 B soft cap")
    if SOUL.exists():
        soul = read(SOUL)
        n = len(soul)
        first = next((l[5:].strip() for l in read(RULES).splitlines() if l.startswith("- [*]")), "")
        pos = soul.find(first[:50]) if first else -1
        floor = 20000  # Hermes agent/prompt_builder.py CONTEXT_FILE_MAX_CHARS
        head_keep, tail_keep = int(floor * 0.7), int(floor * 0.2)
        safe = 0 <= pos < head_keep - 400
        issues.append(f"{'OK' if n <= floor else 'INFO'} SOUL.md {n} chars vs Hermes 20k floor cap "
                      f"(cap = max(20000, ctx_tokens*4*0.06): 20k applies only to models <=83,333 tokens; "
                      f"when truncated keeps head {head_keep} + tail {tail_keep}); first hot rule at char {pos}: "
                      f"{'always kept' if safe else 'AT RISK on small-context models'}")
    for path, label in ((STATE_OUT, "state ORACLE.md"), (CURSOR_OUT, "Cursor rule")):
        issues.append(f"{'OK' if path.exists() else 'MISSING'} {label} {tilde(path)}")
    return issues


def main(argv):
    out = DRY_OUT
    budget = BUDGET
    if "--out" in argv:
        out = Path(argv[argv.index("--out") + 1]).expanduser()
    if "--budget" in argv:
        budget = int(argv[argv.index("--budget") + 1])
    if "--lint" in argv:
        for i in lint():
            print(i)
        return 0
    text, trimmed, sup, ok = build(budget)
    if "--install" in argv:
        if not ok:
            print("over budget; not installing"); return 1
        for path, body in ((STATE_OUT, text), (CURSOR_OUT, CURSOR_HEAD + text)):
            if path.exists() and path.read_text(encoding="utf-8") == body:
                print(f"unchanged {path}"); continue
            if path.exists():
                HISTORY.mkdir(parents=True, exist_ok=True)
                stamp = dt.datetime.fromtimestamp(path.stat().st_mtime).strftime("%Y%m%d-%H%M%S")
                path.rename(HISTORY / f"{path.stem}.{stamp}{path.suffix}")
            path.parent.mkdir(parents=True, exist_ok=True)
            tmp = path.with_suffix(path.suffix + ".tmp")
            tmp.write_text(body, encoding="utf-8")
            os.replace(tmp, path)
            print(f"installed {path} ({len(body)} chars)")
        return 0
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(text, encoding="utf-8")
    print(f"wrote {out} ({len(text)} chars, budget {budget}, {'OK' if ok else 'OVER BUDGET'})")
    print("trimmed items:", ", ".join(f"{k}={v}" for k, v in trimmed.items()), f"| superseded skipped={len(sup)}")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
