#!/usr/bin/env python3
"""Manage ai-main's bounded, persistent memory for Pi."""

from __future__ import annotations

import argparse
from contextlib import contextmanager
import fcntl
import hashlib
import os
from pathlib import Path
import sys
import tempfile
from typing import Iterator

LIMIT = 700
HEADER = "# Pi Persistent Memory\n\n"
PROMPT_START = "<!-- ai-main:pi-memory:start -->"
PROMPT_END = "<!-- ai-main:pi-memory:end -->"


class MemoryStoreError(Exception):
    """A safe memory operation could not be completed."""


def store_path() -> Path:
    return Path(__file__).resolve().parent.parent / "memory" / "pi" / "MEMORY.md"


def render(entries: list[str]) -> str:
    body = "\n".join(f"- {entry}" for entry in entries)
    return HEADER + body + ("\n" if entries else "")


def used_chars(entries: list[str]) -> int:
    return len("\n".join(f"- {entry}" for entry in entries))


def validate_entry(value: str) -> str:
    entry = value.strip()
    if not entry:
        raise MemoryStoreError("memory entries cannot be empty")
    if any(char in entry for char in "\r\n\0"):
        raise MemoryStoreError("each memory entry must fit on one line")
    if PROMPT_START in entry or PROMPT_END in entry:
        raise MemoryStoreError("memory entries cannot contain reserved prompt markers")
    return entry


def read_entries(path: Path) -> list[str]:
    if not path.exists():
        return []

    content = path.read_text(encoding="utf-8")
    if not content.startswith(HEADER):
        raise MemoryStoreError(f"unexpected memory file format: {path}")

    body = content[len(HEADER) :]
    entries: list[str] = []
    for line in body.splitlines():
        if not line.startswith("- "):
            raise MemoryStoreError(f"unexpected memory entry format: {path}")
        entry = validate_entry(line[2:])
        if entry in entries:
            raise MemoryStoreError(f"duplicate memory entry found: {path}")
        entries.append(entry)

    if render(entries) != content:
        raise MemoryStoreError(f"memory file is not in canonical format: {path}")
    if used_chars(entries) > LIMIT:
        raise MemoryStoreError(f"memory file exceeds its {LIMIT}-character limit: {path}")
    return entries


@contextmanager
def store_lock(path: Path) -> Iterator[None]:
    identity = hashlib.sha256(str(path.resolve()).encode("utf-8")).hexdigest()[:24]
    user_id = getattr(os, "getuid", lambda: 0)()
    lock_path = Path(tempfile.gettempdir()) / f"ai-main-pi-memory-{user_id}-{identity}.lock"
    descriptor = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(descriptor, fcntl.LOCK_UN)
        os.close(descriptor)


def atomic_write(path: Path, content: str, mode: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as output:
            output.write(content)
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temporary_name, mode)
        os.replace(temporary_name, path)
    except BaseException:
        try:
            os.unlink(temporary_name)
        except FileNotFoundError:
            pass
        raise


def write_entries(path: Path, entries: list[str]) -> None:
    body_size = used_chars(entries)
    if body_size > LIMIT:
        raise MemoryStoreError(
            f"memory limit exceeded: {body_size}/{LIMIT} characters; consolidate or remove an entry first"
        )
    atomic_write(path, render(entries), 0o600)


def refresh_prompt(entries: list[str]) -> None:
    prompt_path = Path.home() / ".pi" / "agent" / "APPEND_SYSTEM.md"
    if not prompt_path.is_file():
        raise MemoryStoreError(f"Pi prompt not found; deploy ai-main config first: {prompt_path}")

    content = prompt_path.read_text(encoding="utf-8")
    if content.count(PROMPT_START) != 1 or content.count(PROMPT_END) != 1:
        raise MemoryStoreError("Pi prompt memory markers missing or duplicated; run install.sh --sync")

    start = content.index(PROMPT_START) + len(PROMPT_START)
    end = content.index(PROMPT_END)
    if end < start:
        raise MemoryStoreError("Pi prompt memory markers are out of order; run install.sh --sync")

    memory_block = render(entries).rstrip("\n")
    updated = content[:start] + "\n" + memory_block + "\n" + content[end:]
    if updated != content:
        mode = prompt_path.stat().st_mode & 0o777
        atomic_write(prompt_path, updated, mode)


def persist_entries(path: Path, entries: list[str]) -> None:
    write_entries(path, entries)
    try:
        refresh_prompt(entries)
    except (MemoryStoreError, OSError, UnicodeError) as error:
        raise MemoryStoreError(
            f"memory was saved, but OMP prompt refresh failed: {error}"
        ) from error


def find_entry(entries: list[str], needle: str) -> int:
    search = needle.strip()
    if not search:
        raise MemoryStoreError("match text cannot be empty")

    exact = [index for index, entry in enumerate(entries) if entry == search]
    if len(exact) == 1:
        return exact[0]

    matches = [index for index, entry in enumerate(entries) if search in entry]
    if not matches:
        raise MemoryStoreError("no memory entry matched; memory was not changed")
    if len(matches) > 1:
        raise MemoryStoreError(
            f"{len(matches)} entries matched; use a more specific substring; memory was not changed"
        )
    return matches[0]


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="action", required=True)
    commands.add_parser("show", help="show saved entries and current usage")
    add = commands.add_parser("add", help="add one durable, single-line entry")
    add.add_argument("entry")
    replace = commands.add_parser("replace", help="replace one matching entry in full")
    replace.add_argument("match")
    replace.add_argument("entry")
    remove = commands.add_parser("remove", help="remove one matching entry")
    remove.add_argument("match")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    path = store_path()

    try:
        with store_lock(path):
            entries = read_entries(path)
            if args.action == "show":
                if entries:
                    print(render(entries), end="")
                else:
                    print("No memories saved.")
                print(f"Usage: {used_chars(entries)}/{LIMIT} characters")
                return 0

            if args.action == "add":
                entry = validate_entry(args.entry)
                if entry in entries:
                    print(f"Already saved; unchanged ({used_chars(entries)}/{LIMIT} characters).")
                    return 0
                updated = [*entries, entry]
                persist_entries(path, updated)
                print(f"Saved and OMP prompt refreshed; available from the next Pi session ({used_chars(updated)}/{LIMIT} characters).")
                return 0

            if args.action == "replace":
                match = find_entry(entries, args.match)
                replacement = validate_entry(args.entry)
                if replacement == entries[match]:
                    print(f"Already current; unchanged ({used_chars(entries)}/{LIMIT} characters).")
                    return 0
                if replacement in entries:
                    raise MemoryStoreError("replacement duplicates another entry; memory was not changed")
                updated = list(entries)
                updated[match] = replacement
                persist_entries(path, updated)
                print(f"Replaced and OMP prompt refreshed; available from the next Pi session ({used_chars(updated)}/{LIMIT} characters).")
                return 0

            match = find_entry(entries, args.match)
            updated = [entry for index, entry in enumerate(entries) if index != match]
            persist_entries(path, updated)
            print(f"Removed and OMP prompt refreshed; available from the next Pi session ({used_chars(updated)}/{LIMIT} characters).")
            return 0
    except (MemoryStoreError, OSError, UnicodeError) as error:
        print(f"pi-memory: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
